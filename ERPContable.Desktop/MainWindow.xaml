<Window x:Class="ERPContable.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ERP Contable" Width="1366" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B1120">
    <Grid>
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0B1120" />

        <Border x:Name="LoadingPanel" Background="#0B1120">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="ERP CONTABLE" Foreground="#E2E8F0" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,28,0,20" Foreground="#38BDF8" Background="#1E293B" />
                <TextBlock x:Name="StatusText" Text="Preparando la aplicación…" Foreground="#94A3B8" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="RetryButton" Content="Reintentar" Width="120" Height="36" Margin="0,24,0,0" Visibility="Collapsed" Click="RetryButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
